### 模板 2：生产级微服务启停守护脚本（`start.sh`）
> 适用 Linux 服务器端，支持 PID 防复用校验、端口防占用自动清理与启动健康探测。

```bash
#!/usr/bin/env bash
# ==============================================================================
# start.sh: 生产级微服务启停与健康检测脚本
# 用法: bash start.sh <start|stop|restart|status> <service-name>
# ==============================================================================
set -u

APP_HOME="/data/app/backend"
LOGS_DIR="$APP_HOME/logs"
ACTION="${1:-}"
SERVICE="${2:-}"
PORT_MAP_mes_module_mcp="18818"
PORT_MAP_mes_module_ai="18092"

mkdir -p "$LOGS_DIR"

port_of() {
    case "$1" in
        mes-module-mcp) echo "18818" ;;
        mes-module-ai)  echo "18092" ;;
        *)              echo "" ;;
    esac
}

pid_file() { echo "$APP_HOME/${SERVICE}.pid"; }

get_pid() {
    local f; f=$(pid_file)
    if [ -f "$f" ]; then
        local pid; pid=$(tr -dc '0-9' < "$f")
        if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
            echo "$pid" && return 0
        fi
    fi
    return 1
}

stop_service() {
    local pid; pid=$(get_pid) || true
    local port; port=$(port_of "$SERVICE")
    if [ -n "$pid" ]; then
        echo "■ 停止服务: $SERVICE (PID: $pid) ..."
        kill "$pid" 2>/dev/null || true
        for i in $(seq 1 15); do
            [ -d "/proc/$pid" ] || break
            sleep 1
        done
        [ -d "/proc/$pid" ] && kill -9 "$pid" 2>/dev/null || true
    fi
    # 端口清理兜底
    if [ -n "$port" ] && command -v fuser >/dev/null 2>&1; then
        fuser -k -n tcp "$port" 2>/dev/null || true
    fi
    rm -f "$(pid_file)"
    echo "✔ $SERVICE 已停止"
}

start_service() {
    local jar="$APP_HOME/${SERVICE}-exec.jar"
    local port; port=$(port_of "$SERVICE")
    if [ ! -f "$jar" ]; then
        echo "❌ 错误: 未找到 $jar" && exit 1
    fi
    
    echo "▶ 启动服务: $SERVICE ..."
    cd "$APP_HOME"
    nohup java -Xms512m -Xmx1g -XX:+UseG1GC -jar "$jar" > "$LOGS_DIR/${SERVICE}.log" 2>&1 &
    local new_pid=$!
    echo "$new_pid" > "$(pid_file)"
    
    # 端口健康探测（最长等待 120 秒）
    echo ">> 正在探测端口 ${port} 监听状态 ..."
    local ok=false
    for i in $(seq 1 120); do
        if ! kill -0 "$new_pid" 2>/dev/null; then
            echo "❌ $SERVICE 启动闪退，最近日志:"
            tail -n 30 "$LOGS_DIR/${SERVICE}.log"
            exit 2
        fi
        if [ -z "$port" ] || ss -tln | grep -q ":${port} "; then
            ok=true; break
        fi
        sleep 1
    done
    
    if [ "$ok" = "true" ]; then
        echo "✔ $SERVICE 启动成功！PID=$new_pid, 端口=${port:-无/内嵌}"
    else
        echo "❌ 端口 ${port} 探测超时！最新日志:"
        tail -n 30 "$LOGS_DIR/${SERVICE}.log"
        exit 3
    fi
}

case "$ACTION" in
    start)   start_service ;;
    stop)    stop_service ;;
    restart) stop_service && sleep 2 && start_service ;;
    status)
        if pid=$(get_pid); then
            echo "● $SERVICE 正在运行 (PID: $pid)"
        else
            echo "○ $SERVICE 未运行"
        fi
        ;;
    *) echo "用法: $0 <start|stop|restart|status> <service-name>" && exit 1 ;;
esac
```

