## 七、开箱即用通用脚本模板库（附录）

### 模板 1：本地一键远程发布脚本（`deploy-remote.sh`）
> 适用无 Jenkins 环境，在本地开发机执行即可直推服务器。

```bash
#!/usr/bin/env bash
# ==============================================================================
# deploy-remote.sh: 本地一键远程打包并部署到 Linux 服务器
# 用法: ./deploy-remote.sh <service_name>
# 示例: ./deploy-remote.sh mes-module-mcp
# ==============================================================================
set -e

SERVICE="${1:-}"
SERVER_USER="deploy"
SERVER_IP="192.168.1.100"
REMOTE_DIR="/data/app/backend"

if [ -z "$SERVICE" ]; then
    echo "❌ 错误: 请指定微服务名，例如: ./deploy-remote.sh mes-module-mcp"
    exit 1
fi

echo "🚀 [1/4] 本地构建模块: $SERVICE ..."
mvn clean package -pl "$SERVICE" -am -DskipTests

JAR_PATH=$(find "$SERVICE/target" -name "*-exec.jar" | head -n 1)
if [ -z "$JAR_PATH" ]; then
    echo "❌ 错误: 未能在 $SERVICE/target 找到 *-exec.jar"
    exit 1
fi

echo "📦 [2/4] 备份服务器旧版本并同步新 Jar ..."
ssh "${SERVER_USER}@${SERVER_IP}" "mkdir -p ${REMOTE_DIR}/backup && cp -f ${REMOTE_DIR}/${SERVICE}-exec.jar ${REMOTE_DIR}/backup/${SERVICE}-\$(date +%Y%m%d%H%M).jar 2>/dev/null || true"
rsync -avz --progress "$JAR_PATH" "${SERVER_USER}@${SERVER_IP}:${REMOTE_DIR}/${SERVICE}-exec.jar"

echo "🔄 [3/4] 触发远程服务优雅重启与端口探测 ..."
ssh "${SERVER_USER}@${SERVER_IP}" "bash ${REMOTE_DIR}/start.sh restart ${SERVICE}"

echo "🎉 [4/4] 服务 $SERVICE 部署成功并已通过健康自检！"
```

